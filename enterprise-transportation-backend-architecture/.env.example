###############################################################################
# Personal Sedan Services — Automation & AI Orchestration
# Copy to `.env` and populate. Every integration degrades to a labelled
# simulation when its credentials are absent, so local development never blocks.
###############################################################################

# ── Core ─────────────────────────────────────────────────────────────────────
DATABASE_URL=postgresql://localhost:5432/app_db
# Absolute origin used for Slack button deep links into the console.
PUBLIC_APP_URL=https://ops.personalsedanservices.com

# ── Limo Anywhere ────────────────────────────────────────────────────────────
# HMAC-SHA256 secret shared with the Limo Anywhere webhook subscription.
# When unset, signatures are recorded as `unverified` (development only).
LIMO_ANYWHERE_WEBHOOK_SECRET=
# Reserved for outbound Limo Anywhere API lookups (fare reconciliation, status).
LIMO_ANYWHERE_API_KEY=
LIMO_ANYWHERE_API_BASE_URL=https://api.limoanywhere.com

# ── Anthropic Claude ─────────────────────────────────────────────────────────
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-4-5
CLAUDE_MAX_TOKENS=1600
# Hard per-request timeout; webhook handlers never hang on the model.
CLAUDE_TIMEOUT_MS=45000
CLAUDE_MAX_RETRIES=3
CLAUDE_BASE_BACKOFF_MS=900
CLAUDE_MAX_BACKOFF_MS=20000

# ── Google Workspace (service account + domain-wide delegation) ──────────────
# Scopes required: https://www.googleapis.com/auth/gmail.compose
#                  https://www.googleapis.com/auth/spreadsheets
GOOGLE_SERVICE_ACCOUNT_EMAIL=automation@personal-sedan-prod.iam.gserviceaccount.com
# Keep the literal \n sequences; the app converts them to newlines at runtime.
GOOGLE_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\nMIIEv...REPLACE_ME...\n-----END PRIVATE KEY-----\n"
# The Workspace mailbox that owns the drafts and the audit workbook.
GOOGLE_IMPERSONATED_USER=dispatch@personalsedanservices.com
GMAIL_USER_ID=me
GMAIL_DRAFT_SENDER_NAME=Personal Sedan Services Reservations

# Module C audit workbook
GOOGLE_SHEET_ID=
GOOGLE_SHEETS_AUDIT_TAB=Daily Dispatch Audit

# ── Slack incoming webhooks ──────────────────────────────────────────────────
SLACK_AR_WEBHOOK_URL=https://hooks.slack.com/services/T000/B000/REPLACE_ME
SLACK_DISPATCH_WEBHOOK_URL=https://hooks.slack.com/services/T000/B000/REPLACE_ME
SLACK_AR_CHANNEL=#ar-alerts
SLACK_DISPATCH_CHANNEL=#daily-dispatch-log

# ── Brand + dispatch routing ─────────────────────────────────────────────────
RESERVATIONS_FROM_EMAIL=reservations@personalsedanservices.com
DISPATCH_DRAFT_TO=dispatch@personalsedanservices.com
RESERVATIONS_PHONE=(702) 555-0140
OPERATIONS_TIMEZONE=America/Los_Angeles

# ── Workflow policy ──────────────────────────────────────────────────────────
# Invoices escalate only when days_past_due exceeds this threshold.
AR_ESCALATION_DAYS=30
# Module C trailing window.
AUDIT_LOOKBACK_HOURS=24
# Bearer secret for /api/cron/* endpoints. Unset = open (development only).
CRON_SECRET=
