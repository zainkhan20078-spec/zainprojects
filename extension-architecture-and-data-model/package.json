{
  "name": "bachillerato-study-extension",
  "private": true,
  "version": "0.2.0",
  "description": "Local-first Chrome Manifest V3 extension for 2 Bachillerato study workflows.",
  "type": "module",
  "engines": {
    "node": ">=22.13.0"
  },
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "preview": "vite preview",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "lint": "eslint src",
    "format": "prettier --write src",
    "format:check": "prettier --check src",
    "validate:production": "node scripts/validate-production.mjs"
  },
  "dependencies": {
    "clsx": "2.1.1",
    "dexie": "^4.4.6",
    "fflate": "^0.8.3",
    "node-unrar-js": "^2.0.2",
    "pdfjs-dist": "^6.2.108",
    "react": "19.2.6",
    "react-dom": "19.2.6",
    "tailwind-merge": "3.4.0",
    "tesseract.js": "^7.0.0",
    "unrar-js": "^0.2.3"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@tailwindcss/postcss": "^4.3.3",
    "@tailwindcss/vite": "4.1.17",
    "@types/chrome": "^0.3.5",
    "@types/node": "22.19.17",
    "@types/react": "19.2.7",
    "@types/react-dom": "19.2.3",
    "@vitejs/plugin-react": "5.1.1",
    "@vitest/coverage-v8": "^5.0.5",
    "eslint": "^10.12.0",
    "eslint-plugin-react-hooks": "^7.1.1",
    "fake-indexeddb": "^6.2.5",
    "jsdom": "^30.1.3",
    "postcss": "^8.5.30",
    "prettier": "^3.9.10",
    "tailwindcss": "4.1.17",
    "typescript": "5.9.3",
    "typescript-eslint": "^8.71.2",
    "vite": "7.3.7",
    "vitest": "^5.0.5"
  }
}
